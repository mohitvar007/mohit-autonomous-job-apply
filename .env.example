# Required: choose a long random value and set it in your hosting provider too.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional: PostgreSQL connection string for hosted persistent data.
# DATABASE_URL=

# Default hosted scan cooldown; Remotive recommends max 4 requests/day.
MIN_SCAN_INTERVAL_HOURS=12

# Keep false on Render when using GitHub Actions for scheduled scans.
ENABLE_IN_PROCESS_CRON=false
# Used only when ENABLE_IN_PROCESS_CRON=true
SCAN_CRON=0 8,20 * * *

# Optional: Google Jobs aggregation via SerpApi
# SERPAPI_API_KEY=

# Optional: Adzuna India job-search API
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
